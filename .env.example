# K Agentic Harness — Environment Variables
# Copy this file to .env and fill in values
# All variables are optional; defaults are shown in comments

# ── Auth ───────────────────────────────────────────────────────────────────────

# API bearer token for web → core authentication.
# Leave UNSET to auto-generate a strong token on first run and persist it to
# data/auth-token (printed once, then masked). Set it to pin your own token.
# Core refuses to start if HOST is non-loopback while this is weak/empty.
# Default: none (auto-generated + persisted)
# HARNESS_TOKEN=your-strong-token-here

# ── HTTP server ────────────────────────────────────────────────────────────────

# Port the Fastify server listens on
# Default: 3001
PORT=3001

# Host/IP to bind. Only set 0.0.0.0 BEHIND Tailscale or an authenticating HTTPS
# reverse proxy (see bible §09 → Remote access). Core refuses to bind a
# non-loopback host with a weak/empty HARNESS_TOKEN.
# Default: 127.0.0.1 (loopback only)
HOST=127.0.0.1

# CORS origin allowed to send credentialed requests to the API
# Default: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Storage ────────────────────────────────────────────────────────────────────

# Directory for SQLite database (k.db) and other persistent data
# Default: <repo-root>/data
K_DATA_DIR=/path/to/data

# ── Agent model routing ────────────────────────────────────────────────────────

# Claude model to use for agent runs (via claude CLI)
# Default: claude-sonnet-4-6
CLAUDE_MODEL=claude-sonnet-4-6

# Permission mode for claude CLI runs: default | acceptEdits | bypassPermissions | plan
# bypassPermissions is required for agents that write/edit files autonomously
# Default when unset or invalid: acceptEdits (see core/src/claude-args.ts resolvePermissionMode)
RUN_PERMISSION_MODE=default

# ── Ollama integration (local models, disabled by default) ────────────────────

# Set to "true" to allow routing runs to a local Ollama instance. Even when
# enabled, the router only selects Ollama once a background probe confirms it is
# reachable; otherwise it degrades to claude (a routing choice never fails a run).
# Cost-aware routing: a run dispatched with a maxCostUsd hint prefers the free
# local model when completed claude runs have historically cost more than the cap.
# Default: false
ENABLE_OLLAMA=false

# Ollama API base URL
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use when ENABLE_OLLAMA=true
# Default: llama3.2
OLLAMA_MODEL=llama3.2

# ── Voice / Whisper integration (local speech-to-text, disabled by default) ────

# Set to "true" to enable the POST /api/transcribe endpoint. When disabled the
# endpoint returns 503. The browser never holds a key — core proxies audio to
# the local Whisper server and returns text.
# Default: false
ENABLE_VOICE=false

# Base URL of the local OpenAI-compatible Whisper server
# Default: http://localhost:9000
WHISPER_BASE_URL=http://localhost:9000

# Whisper model to use for transcription
# Default: whisper-base.en
WHISPER_MODEL=whisper-base.en

# ── GitHub integration ─────────────────────────────────────────────────────────

# GitHub polling interval in milliseconds (how often to refresh PR/CI status)
# Default: 60000 (60 seconds)
GITHUB_POLL_MS=60000

# Set to "false" to disable GitHub polling (useful for CI or offline development)
# Default: true (polling enabled when projects have a githubRemote)
ENABLE_GITHUB_POLL=true

# ── Web terminal (sensitive — shell access, disabled by default) ───────────────

# Set to "true" to enable the browser terminal: a node-pty shell bridged over the
# /ws/terminal WebSocket and rendered with xterm.js. This grants shell access to
# the host, so it is OFF by default and auth-guarded by TERMINAL_TOKEN (below),
# passed as the `token` query param on the WS URL. node-pty is imported
# dynamically; if its native binding is unavailable the client sees a clean error
# and the server never crashes. Keep this off unless you understand the exposure.
# Default: false
ENABLE_TERMINAL=false

# Credential for the web terminal WS. This is the ONLY token embedded in the
# compiled web bundle (vite.config.ts), so it is deliberately SEPARATE from
# HARNESS_TOKEN — a leaked bundle grants only terminal access, never the full
# REST API. Set a strong value before enabling the terminal on any non-loopback
# HOST. Default: dev-terminal-token
TERMINAL_TOKEN=dev-terminal-token

# ── Test / CI ─────────────────────────────────────────────────────────────────

# Set to "1" to skip the bootstrap (listen/poller) when importing index.ts in tests
# Default: unset (bootstrap runs normally)
# K_SKIP_BOOTSTRAP=1
