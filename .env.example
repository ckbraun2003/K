# K Agentic Harness — Environment Variables
# Copy this file to .env and fill in values
# All variables are optional; defaults are shown in comments

# ── Auth ───────────────────────────────────────────────────────────────────────

# API bearer token for web → core authentication.
# Leave UNSET to auto-generate a strong token on first run and persist it to
# data/auth-token (printed once, then masked). Set it to pin your own token.
# Core refuses to start if HOST is non-loopback while this is weak/empty.
# Default: none (auto-generated + persisted)
# HARNESS_TOKEN=your-strong-token-here

# ── HTTP server ────────────────────────────────────────────────────────────────

# Port the Fastify server listens on
# Default: 3001
PORT=3001

# Host/IP to bind. Only set 0.0.0.0 BEHIND Tailscale or an authenticating HTTPS
# reverse proxy (see bible §09 → Remote access). Core refuses to bind a
# non-loopback host with a weak/empty HARNESS_TOKEN.
# Default: 127.0.0.1 (loopback only)
HOST=127.0.0.1

# CORS origin allowed to send credentialed requests to the API
# Default: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Storage ────────────────────────────────────────────────────────────────────

# Directory for SQLite database (k.db) and other persistent data
# Default: <repo-root>/data
K_DATA_DIR=/path/to/data

# ── Agent model routing ────────────────────────────────────────────────────────

# Claude model to use for agent runs (via claude CLI)
# Default: claude-sonnet-4-6
CLAUDE_MODEL=claude-sonnet-4-6

# Permission mode for claude CLI runs: default | acceptEdits | bypassPermissions | plan
# bypassPermissions is required for agents that write/edit files autonomously
# Default when unset or invalid: acceptEdits (see core/src/claude-args.ts resolvePermissionMode)
RUN_PERMISSION_MODE=default

# ── Ollama integration (local models, disabled by default) ────────────────────

# Set to "true" to allow routing runs to a local Ollama instance. Even when
# enabled, the router only selects Ollama once a background probe confirms it is
# reachable; otherwise it degrades to claude (a routing choice never fails a run).
# Cost-aware routing: a run dispatched with a maxCostUsd hint prefers the free
# local model when completed claude runs have historically cost more than the cap.
# Default: false
ENABLE_OLLAMA=false

# Ollama API base URL
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use when ENABLE_OLLAMA=true
# Default: llama3.2
OLLAMA_MODEL=llama3.2

# ── Voice / Whisper integration (local speech-to-text, disabled by default) ────

# Set to "true" to enable the POST /api/transcribe endpoint. When disabled the
# endpoint returns 503. The browser never holds a key — core proxies audio to
# the local Whisper server and returns text.
# Default: false
ENABLE_VOICE=false

# Base URL of the local OpenAI-compatible Whisper server
# Default: http://localhost:9000
WHISPER_BASE_URL=http://localhost:9000

# Whisper model to use for transcription
# Default: whisper-base.en
WHISPER_MODEL=whisper-base.en

# ── GitHub integration ─────────────────────────────────────────────────────────

# GitHub polling interval in milliseconds (how often to refresh PR/CI status)
# Default: 60000 (60 seconds)
GITHUB_POLL_MS=60000

# Set to "false" to disable GitHub polling (useful for CI or offline development)
# Default: true (polling enabled when projects have a githubRemote)
ENABLE_GITHUB_POLL=true

# ── Web terminal (sensitive — shell access, disabled by default) ───────────────

# Set to "true" to enable the browser terminal: a node-pty shell bridged over the
# /ws/terminal WebSocket and rendered with xterm.js. This grants shell access to
# the host, so it is OFF by default and auth-guarded by TERMINAL_TOKEN (below),
# passed as the `token` query param on the WS URL. node-pty is imported
# dynamically; if its native binding is unavailable the client sees a clean error
# and the server never crashes. Keep this off unless you understand the exposure.
# Default: false
ENABLE_TERMINAL=false

# Credential for the web terminal WS. This is the ONLY token that could be embedded
# in the compiled web bundle (vite.config.ts) — and only in a DEV build; a PROD
# build bakes NO terminal token (it emits `undefined`, so the token is injected at
# runtime). It is deliberately SEPARATE from HARNESS_TOKEN — a leaked bundle grants
# only terminal access, never the full REST API. Set a strong value before enabling
# the terminal on any non-loopback HOST. Default: dev-terminal-token
TERMINAL_TOKEN=dev-terminal-token

# Explicit opt-in to expose the web terminal (a host shell) on a NON-loopback HOST.
# Even with a strong TERMINAL_TOKEN, K refuses to boot with ENABLE_TERMINAL=true on
# a non-loopback HOST unless this is "true" — so an accidental LAN bind can never
# expose the shell silently. Loopback is unaffected. Default: false
# TERMINAL_ALLOW_REMOTE=false

# ── Agent credentials (managed token vs host-credential fallback) ──────────────

# By default, when NO managed token (ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN) is
# set, K copies the host ~/.claude/.credentials.json into each run so it authenticates
# out of the box (the "dogfooding fallback"). Set this to "true" for a security-
# conscious deployment to OPT OUT: K then refuses to copy host credentials and fails
# closed to UNAUTHENTICATED until a managed token is set. Setting a managed token is
# also how you keep a credential file out of the persistent K-secretary session dir.
# Default: false (fallback on)
# K_DISABLE_HOST_CREDENTIAL_FALLBACK=false

# ── Desktop app (set by the Electron shell; also usable for a standalone core) ─

# Directory of the BUILT web SPA (web/dist). When set, core serves the React bundle
# itself via @fastify/static, so the whole app lives on ONE origin (relative /api +
# same-host WS, no CORS). The desktop app points this at its bundled web/dist; unset,
# core only answers /api + /ws and Vite serves the SPA in dev. Only takes effect when
# the dir actually contains index.html. Default: unset (no same-origin serving)
# K_WEB_DIST=/path/to/web/dist

# Writable repo-root override. REPO_ROOT / ARTIFACTS_DIR / WORKSPACE_DIR (core's
# repo-relative .worktrees / artifacts / workspace) follow this instead of the repo.
# The desktop app sets it to a per-user writable dir because the install is read-only;
# agent-config stays read from the bundled (read-only) location regardless.
# Default: unset (core uses its in-repo paths)
# K_REPO_ROOT=/path/to/writable/runtime

# Node binary the desktop shell spawns core with. The packaged app bundles its own
# Node-20 (core's better-sqlite3 is ABI 115 — NOT Electron's ABI 130), and this
# overrides which node runs core (CI / debugging). Core itself ignores this — it is a
# shell-side seam. Default: bundled node (packaged) / system `node` (dev)
# K_NODE_BIN=/path/to/node

# Set to "1" to suppress core's first-run full-token banner on stdout. The desktop
# shell sets it because it reads the token straight from data/auth-token; the token is
# still generated + persisted, just not printed. Default: unset (banner printed once)
# K_SUPPRESS_TOKEN_PRINT=1

# ── Test / CI ─────────────────────────────────────────────────────────────────

# Set to "1" to skip the bootstrap (listen/poller) when importing index.ts in tests
# Default: unset (bootstrap runs normally)
# K_SKIP_BOOTSTRAP=1
