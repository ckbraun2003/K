{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@k/shared": ["../shared/src/types.ts"]
    }
  },
  // Only compile core's own sources so the emitted entry is a stable
  // `dist/index.js` (previously `../shared/src` was included, which pushed the
  // common rootDir up and emitted the nested `dist/core/src/index.js` that broke
  // `start`). `@k/shared` is type-checked via the `paths` mapping above and
  // resolved at runtime from its own built `dist` (see shared/package.json).
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
