{
  "compilerOptions": {
    "target": "ES2022",
    // CommonJS: Electron's main + a sandboxed preload load as CJS. The renderer
    // SPA is served by core; nothing here is bundled for the browser.
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test"]
}
