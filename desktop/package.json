{
  "name": "@k/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "K desktop app — Electron shell around the bundled core + web SPA",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && electron dist/main.js",
    "test": "vitest run",
    "smoke:abi": "node scripts/abi-report.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^38.8.6",
    "typescript": "^5.5.0",
    "vitest": "^1.6.1"
  }
}
